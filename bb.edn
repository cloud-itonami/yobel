{:paths ["src" "test"]
 :deps {io.github.kotoba-lang/langgraph
        {:git/url "https://github.com/kotoba-lang/langgraph.git"
         :git/sha "a75fe35038dc9218e26b7da4940989cd13754769"}
        io.github.kotoba-lang/eth-crypto
        {:git/url "https://github.com/kotoba-lang/eth-crypto.git"
         :git/sha "0f6fb314fc463f1891622665eeebdaebc90eba0d"}}
 :tasks {test {:task (load-file "run_tests.kotoba")}
         test:integration {:doc "Operator-run Anvil integration suite"
